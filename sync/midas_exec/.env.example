# ------------------------------------------------------------------ MIDAS executor (.env keys)
# MIDAS's real-money-capable Binance bridge (gold XAUUSDT). Namespaced MIDAS_* so it coexists on the
# SAME .env as the OPUS executor (EXEC_*/RISK_*). TESTNET + DRY-RUN first; a Binance-fee simulation
# gates any mainnet arming (MIDAS dies on Binance taker — see MIDAS.md).

# ---- shared master / network / secrets (also used by the OPUS executor) ----
LIVE_TRADING_ENABLED=false            # shared master kill (false => both executors no-op)
# BINANCE_TESTNET=false               # OPUS's network flag — MIDAS ignores this, see MIDAS_BINANCE_TESTNET
# STRICT key separation (no cross-fallback): paper (testnet) uses ONLY the testnet key, live (mainnet)
# uses ONLY the mainnet key. Missing the required key while armed => fail-closed.
# BINANCE_API_KEY=...                 # LIVE / mainnet key (used when MIDAS_BINANCE_TESTNET=false; also OPUS)
# BINANCE_API_SECRET=...
# BINANCE_TESTNET_API_KEY=...         # PAPER / testnet key (used when MIDAS_BINANCE_TESTNET=true)
# BINANCE_TESTNET_API_SECRET=...
# BINANCE_PROXY=                      # optional egress proxy (geo-blocked runners)
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# TELEGRAM_EXEC_CHAT_ID=...           # executor alerts route here (falls back to TELEGRAM_CHAT_ID)

# ---- MIDAS-specific ----
MIDAS_EXEC_ENABLED=false              # per-strategy arm (lets MIDAS run while OPUS is off, and vice-versa)
MIDAS_EXEC_DRY_RUN=true               # true => compute + log intents, send NOTHING
MIDAS_BINANCE_TESTNET=true            # MIDAS's OWN network flag (independent of BINANCE_TESTNET): true =>
                                      # testnet base + BINANCE_TESTNET_API_KEY/SECRET. Flip to false only
                                      # when MIDAS graduates to mini-mainnet (keeps OPUS on mainnet meanwhile).
MIDAS_SYMBOL=XAUUSDT
MIDAS_RISK_PER_TRADE_USD=2.0          # USD lost if the 1.5*ATR initial stop hits
MIDAS_LEVERAGE=5                      # fixed; exchange clamps to the gold TradFi bracket
MIDAS_MARGIN_TYPE=ISOLATED
MIDAS_MAX_CONCURRENT=1                # single position (also enforced by the unique index)
MIDAS_MAKER_ENTRY=true                # post-only LIMIT (GTX); false => MARKET (testnet convenience only)
MIDAS_ENTRY_TIMEOUT_SEC=120           # cancel-and-skip an unfilled maker entry after this
MIDAS_ENTRY_MAX_SLIP_R=0.25           # abandon the entry if price ran this many R past the signal ref
MIDAS_SL_DEADBAND_TICKS=2             # only cancel/replace the resting stop past this many ticks (mainnet)
MIDAS_EXEC_VERSION=midasx             # trading_signals writeback tag (distinct from paper 'midas')
MIDAS_EXEC_NAME=MIDAS-X               # Telegram prefix
