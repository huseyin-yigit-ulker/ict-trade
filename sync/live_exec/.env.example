# d30so8c live-execution config — COPY the keys into the VM's real .env (never commit secrets).
# Master no-op default: LIVE_TRADING_ENABLED=false means both crons do nothing.

LIVE_TRADING_ENABLED=false      # master kill flag; false => executor + safety_sweep no-op
EXEC_DRY_RUN=true               # Faz 0: compute + log intended orders, send NOTHING
BINANCE_TESTNET=false           # mainnet REST base (testnet base used only for the optional fallback)

BINANCE_API_KEY=                # MAINNET creds (used when BINANCE_TESTNET=false)
BINANCE_API_SECRET=
BINANCE_TESTNET_API_KEY=        # TESTNET creds (used when BINANCE_TESTNET=true); both pairs can coexist
BINANCE_TESTNET_API_SECRET=
BINANCE_PROXY=                  # optional egress proxy if the runner is geo-blocked (see dag.py)

LIVE_ENTRY_MODE=B               # B = ·0.5R confirmed entry (matches the d30so8c dashboard record)
DCH_SO_RUNNER_CAP=8             # 8R runner cap (also tags scaleout VERSION=d30so8c)
DCH_ENTRY_AT_CONFIRM=1          # realistic ·0.5R entry model

RISK_PER_TRADE_USD=5            # USD lost if the full position hits SL
LEVERAGE=3
MARGIN_TYPE=ISOLATED
MAX_CONCURRENT_POSITIONS=3      # BTC/ETH/SOL each one
MAX_TOTAL_RISK_USD=15

EXEC_ENABLED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT   # must be a subset of scaleout.SO_SYMBOLS
TELEGRAM_EXEC_CHAT_ID=          # optional; falls back to TELEGRAM_CHAT_ID
