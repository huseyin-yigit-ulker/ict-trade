# 01:40 — TALOS backtest refresh: rebuild version='talos' from XAUUSDT 1m for 2026 each night
#   (DELETE + re-upsert, idempotent). Engine: sync/talos/backfill.py ($0.50/oz FX-cost, gold-only).
40 1 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/talos/backfill.py --apply >> $HOME/ict-talos.log 2>&1

# TALOS-ICHI live emit + trailing track — ARAŞTIRMA/PAPER (mode='talos_ichi'). EVERY MINUTE (+45s,
