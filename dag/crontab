# PUSU live cron — DONCHIAN-ONLY (2026-06-16). Apply on VM: crontab dag/crontab (verify: crontab -l)
# All other streams retired (UI + DB + live): MAIN(:01), IMPULSE(:02), halftp_monitor(*/5)
# removed — see sync/donchian/RETIRED_STREAMS_REPORT.md.
#
# DONCHIAN live emit (minute :01, hourly) — Donchian(55) breakout, ER>=0.35 strong-trend
#   gate (mode='donchian'). Emits on freshly-closed 1h bars and sends a DONCHIAN-labelled
#   Telegram alert per new signal.
1 * * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/canli.py --emit >> $HOME/ict-donchian.log 2>&1
# Daily resolve: donchian live signals -> backtest trading_signals (version='donchian')
#   via sync_daily ACTIVE_STREAMS=['donchian'].
30 0 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/sync_daily.py --stream all >> $HOME/ict-sync.log 2>&1
