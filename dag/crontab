# PUSU live cron — DONCHIAN-ONLY (2026-06-16). Apply on VM: crontab dag/crontab (verify: crontab -l)
# All other streams retired (UI + DB + live): MAIN(:01), IMPULSE(:02), halftp_monitor(*/5)
# removed — see sync/donchian/RETIRED_STREAMS_REPORT.md.
#
# Emit ONLY at the BAR CLOSE (+10s) — no more */10 re-scan. The 1h stream runs on the hour (:00),
# the 30m streams on :00/:30. The signal forms at the bar close so a boundary run catches it; the
# +10s lets Binance finalise the just-closed bar. The emitter writes the RAW setup (Donchian break
# + 4h-dir confirm) and Telegram-alerts it AT FORMATION — NO +0.5R gate here. The +0.5R confirmation
# is DOWNSTREAM: the UI/live module on live data + the nightly backtest on 1m history (prune_live
# drops the failed ones) — so there's nothing to re-check mid-period. The 1.5h lookback re-catches a
# bar if a run is late/missed; canli.py dedups on (symbol, signal_time, direction, mode).
#
# DONCHIAN 1h live emit — on the HOUR (:00:10): Donchian(55) 1h breakout, ER>=0.35 gate
#   (mode='donchian'). Telegram ON: alerts EVERY 1h signal at formation (user wants 1h signal pings).
0 * * * * sleep 10 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/canli.py --emit >> $HOME/ict-donchian.log 2>&1
# DONCHIAN 30m+4h HYBRID live emit — on :00/:30 (+10s): 30m breakout confirmed by 4h trend
#   (mode='dch30_4h'). Best stream overall + the one the live executor trades. Telegram ON for ALL
#   symbols at formation (signal heads-up); the live-traded set (FET/SUSDT/SOL) additionally gets full
#   entry/exit detail from the executor. (6R below stays silent — it's a DUPLICATE of these breakouts.)
0,30 * * * * sleep 10 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/canli.py --emit --tf 30m --confirm-htf 4h --name OPUS >> $HOME/ict-donchian.log 2>&1
# DONCHIAN 30m+4h · 6R live emit — on :00/:30 (+10s): same hybrid signals, wider 6R target
#   (mode='dch30_4h6'). MFE-validated: ~2x R/trade vs 4R, OOS-robust across 2024-26.
0,30 * * * * sleep 10 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/canli.py --emit --tf 30m --confirm-htf 4h --rr 6 --no-telegram >> $HOME/ict-donchian.log 2>&1
# DONCHIAN 30m+4h · VOLUME-GATE live emit — on :00/:30 (+15s): same hybrid signals, but only those
#   whose symbol's daily volume is CONTRACTING (vch<0.9) at signal time (mode='dch30_4hvg'). The
#   live-monitored (paper) twin of d30so8f3h7 -> backtest version='d30so8f3vg' (volgate_backfill.py).
#   Robustly lower SL-rate + worst-month / higher WR (fewer trades). NOT traded on Binance (executor
#   still trades only ungated dch30_4h). Telegram ON as FABLE (volume-gate = its confirmation).
0,30 * * * * sleep 15 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/canli.py --emit --tf 30m --confirm-htf 4h --volume-gate 0.9 --name FABLE >> $HOME/ict-donchian.log 2>&1
# CRON HEALTH-CHECK — DISABLED 2026-06-24 (user: no unnecessary Telegram). The 6h "I'm alive" ping
#   was pure noise now that the executor pings only on real trades. Re-enable by uncommenting.
# 0 */6 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/heartbeat.py >> $HOME/ict-donchian.log 2>&1
# Daily resolve -> the REALISTIC ·0.5R UI versions (the only ones the UI shows). The non-
#   conservative twins (donchian/dch30_4h/dch30_4h6/d30_4h_so) were removed from the UI, so they
#   are no longer resolved. DCH_ENTRY_AT_CONFIRM=1 shifts the entry to the +0.5R confirm level and
#   auto-tags rows with a 'c' suffix; DCH_SO_RUNNER_CAP picks the scale-out runner cap.
# 00:30 — full-TP donchianc / dch30_4hc / dch30_4h6c  +  scale-out d30_4h_soc (cap=4, default).
#         Also self-heals the live table (prune_live drops signals that failed dir-confirm).
30 0 * * * cd $HOME/ict-trade && DCH_ENTRY_AT_CONFIRM=1 $HOME/ict-trade/.venv/bin/python sync/sync_daily.py --stream all >> $HOME/ict-sync.log 2>&1
# 00:45 — scale-out 6R cap (same dch30_4h signals, wider runner) -> d30so6c.
45 0 * * * cd $HOME/ict-trade && DCH_ENTRY_AT_CONFIRM=1 DCH_SO_RUNNER_CAP=6 $HOME/ict-trade/.venv/bin/python sync/sync_daily.py --stream d30_4h_so >> $HOME/ict-sync.log 2>&1
# 01:00 — scale-out 8R cap -> d30so8c.
0 1 * * * cd $HOME/ict-trade && DCH_ENTRY_AT_CONFIRM=1 DCH_SO_RUNNER_CAP=8 $HOME/ict-trade/.venv/bin/python sync/sync_daily.py --stream d30_4h_so >> $HOME/ict-sync.log 2>&1
# 01:20 — VOLUME-GATE backtest refresh: rebuild version='d30so8f3vg' (the vch<0.9-gated d30so8f3h7
#         twin) from the full universe 2024-now each night (DELETE + re-upsert, idempotent), so the
#         d30so8f3vg BACKTEST view stays current. The live dch30_4hvg emit feeds the CANLI view; this
#         keeps the backtest view fresh. (Replaced the retired demo_backtest cron — demo was removed
#         2026-06-28; demo_backtest.py is kept only as a template.)
20 1 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/donchian/volgate_backfill.py --apply >> $HOME/ict-sync.log 2>&1

# --- MIDAS (gold-only intraday VWAP-trend; INDEPENDENT from the Donchian book) ---
# MIDAS live emit + LIVE TRAILING TRACK — PAPER (mode='midas'). Runs EVERY MINUTE. Each run: (1) emits
# fresh VWAP-trend setups (real FX-gold hours + session filter: Asia/Overlap/NY, London 07-13 UTC
# skipped, Fri flat 16:00 ET, no weekend); (2) replays every OPEN position's trailing stop and pushes
# a Telegram alert on EVERY trailing-stop change (--sl-step 0: trade + stop detail each ratchet) and on
# exit. TELEGRAM ON (same bot as OPUS/FABLE). Set --sl-step 0.5 for milestone-only; --no-telegram to mute.
# Executor NOT touched; nightly backtest below is the authoritative book.
* * * * * sleep 20 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/midas/canli.py --emit --lookback-min 3 --sl-step 0 >> $HOME/ict-midas.log 2>&1
# 01:30 — MIDAS backtest refresh (END OF DAY): rebuild version='midas' from XAUUSDT 1m for 2026 each
#   night (DELETE + re-upsert, idempotent), so the MIDAS backtest view extends as the year accrues.
#   FX/ECN cost model ($0.50/oz round-trip) — gold-only, 2026-only. Engine: sync/midas/backfill.py.
30 1 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/midas/backfill.py --apply >> $HOME/ict-midas.log 2>&1

# --- d30so8c LIVE EXECUTION (Binance USDⓈ-M; testnet/mainnet via .env BINANCE_TESTNET) ---
# Reconciler (cron #1): reads the SAME dch30_4h signals, drives real orders reproducing
# scaleout (entry +0.5R / SL / TP1 +1R 60% / runner +6R cap·BE·3d). Offset off the :00/:30
# emitter boundary. Both lines no-op while .env LIVE_TRADING_ENABLED=false. Knobs live in .env.
# Every 2 min: protection is now EXCHANGE-SIDE (algo SL/TP placed at entry), so the cron only
# enters/places the bracket, finalizes fills, reverses, and time-stops — synthetic SL is just a backstop.
*/2 * * * * sleep 25 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/live_exec/executor.py     >> $HOME/ict-exec.log 2>&1
# Safety sweep (cron #2): independent orphan/protective-stop/clock-skew/risk-cap guard.
*/5 * * * * sleep 50 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/live_exec/safety_sweep.py  >> $HOME/ict-exec.log 2>&1

# --- MIDAS-X LIVE EXECUTION (Binance TRADIFI_PERPETUAL XAUUSDT; TESTNET/dry-run first) ---
# MIDAS's real-money-capable bridge: reads the SAME mode='midas' signals (paper feed above), places a
# POST-ONLY maker LIMIT entry, then rides the 3.5*ATR chandelier trailing stop (sync/midas/strategy.
# track_open) to an 8h/session exit. Records real fills under version='midasx' (distinct from the paper
# 'midas' the nightly backfill rewrites). SEPARATE tables/env/killswitch from OPUS (never cross-flatten).
# ⚠️ MIDAS dies on Binance taker fees (+142R FX -> -92R taker) — a Binance-fee sim gates any mainnet arm.
# BOTH lines no-op while LIVE_TRADING_ENABLED=false OR MIDAS_EXEC_ENABLED=false OR MIDAS_EXEC_DRY_RUN=true.
# Executor every minute (matches the 1m chandelier), offset +35s off the :20s canli emit.
* * * * * sleep 35 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/midas_exec/executor.py     >> $HOME/ict-midas-exec.log 2>&1
# Safety sweep (cron #2): independent XAUUSDT-scoped orphan/reconciler-freshness/clock-skew guard.
*/3 * * * * sleep 50 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/midas_exec/safety_sweep.py >> $HOME/ict-midas-exec.log 2>&1
