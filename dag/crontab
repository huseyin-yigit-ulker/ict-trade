* * * * * sleep 45 && cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/talos_ichi/canli.py --emit --lookback-min 3 --sl-step 0 >> $HOME/ict-talos-ichi.log 2>&1
# 01:50 — TALOS-ICHI backtest refresh: rebuild version='talos_ichi' from XAUUSDT 1m for 2026 nightly
#   (DELETE + re-upsert, idempotent). Engine: sync/talos_ichi/backfill.py ($0.50/oz FX-cost, gold-only).
50 1 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/talos_ichi/backfill.py --apply >> $HOME/ict-talos-ichi.log 2>&1

