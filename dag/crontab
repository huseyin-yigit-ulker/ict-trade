# PUSU live cron — strategy set = RANGE + OPUS (2026-06-14).
# Install on the VM with:  crontab dag/crontab   (verify: crontab -l)
#
# MAIN 'live' scan (minute :01) — KEPT: it is OPUS's signal source. OPUS = these
#   MAIN signals, filtered per-symbol to its NY session in the dashboard (OPUS_MAP).
#   Not shown as a standalone strategy anymore, only as OPUS's plumbing.
1 * * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python dag/dag.py >> $HOME/ict-main.log 2>&1
# RANGE live scan (minute :03) — NEW: Burak RANGE_DEV + ensemble-trend gate, all 40
#   symbols, every session (mode='range'). Parity with the backtest 'range' stream.
3 * * * * cd $HOME/ict-trade && SCAN_MODE=range $HOME/ict-trade/.venv/bin/python dag/dag.py >> $HOME/ict-range.log 2>&1
# IMPULSE scan REMOVED (2026-06-14) — "diğer live'ları kapat".
# Daily resolve/sync of live -> backtest (unchanged).
30 0 * * * cd $HOME/ict-trade && $HOME/ict-trade/.venv/bin/python sync/sync_daily.py --stream all >> $HOME/ict-sync.log 2>&1
