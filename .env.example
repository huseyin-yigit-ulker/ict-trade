# ============================================================================
# PUSU — Liquidity Ambush Intelligence: Environment Configuration Template
# ============================================================================
# COPY this file to .env and fill in your values. NEVER commit real secrets to git.

# --- 1. Telegram Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- 2. Database & Supabase (Postgres & RLS) ---
DB_CONNECTION_STRING=postgresql://postgres.xxxx:your_db_password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
DB_TABLE=ict_trade.signals
DB_CONNECTION_STRING_V2=postgresql://postgres.xxxx:your_db_password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Backtest Database (isolated schema/project)
BACKTESTING_DB_CONNECTION_STRING=postgresql://postgres.xxxx:your_backtest_db_password@aws-1-eu-central-1.pooler.supabase.com:6543/postgres
BACKTESTING_DB_TABLE=ict_backtest.trading_signals

# Client-facing Supabase configuration (Vite exposed via VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_or_anon_key

BACKTESTING_VITE_SUPABASE_URL=https://your-backtest-project-id.supabase.co
BACKTESTING_VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_backtest_supabase_publishable_key

# Optional GitHub Token for automated actions
GITHUB_TOKEN=

# --- 3. Binance API Credentials (FUTURES) ---
# Mainnet Credentials (used when *_BINANCE_TESTNET=false)
BINANCE_API_KEY=your_binance_mainnet_api_key
BINANCE_API_SECRET=your_binance_mainnet_api_secret

# Testnet Credentials (used when *_BINANCE_TESTNET=true)
BINANCE_TESTNET_API_KEY=your_binance_testnet_api_key
BINANCE_TESTNET_API_SECRET=your_binance_testnet_api_secret

# --- 4. OPUS Execution Engine (Crypto Futures) ---
LIVE_TRADING_ENABLED=false
EXEC_DRY_RUN=true
BINANCE_TESTNET=true
LIVE_ENTRY_MODE=B
DCH_SO_RUNNER_CAP=8
DCH_ENTRY_AT_CONFIRM=1
RISK_PER_TRADE_USD=5
LEVERAGE=3
MARGIN_TYPE=ISOLATED
MAX_CONCURRENT_POSITIONS=3
MAX_TOTAL_RISK_USD=15
EXEC_ENABLED_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
EXEC_VERSION=d30so8f3h7
EXEC_NAME=OPUS
AUTO_LEVERAGE=true
LEVERAGE_MAX=10

# --- 5. TALOS-ICHI Execution Engine (Gold XAUUSDT Futures) ---
TALOS_ICHI_EXEC_ENABLED=false
TALOS_ICHI_EXEC_DRY_RUN=true
TALOS_ICHI_BINANCE_TESTNET=true
TALOS_ICHI_RISK_PER_TRADE_USD=3
TALOS_ICHI_MAKER_ENTRY=true
TALOS_ICHI_AUTO_LEVERAGE=true
TALOS_ICHI_LEVERAGE_MAX=100
TALOS_ICHI_TARGET_MARGIN_USD=15
TALOS_ICHI_LEVERAGE=25
TALOS_ICHI_EXEC_AFTER_LOSS_ONLY=true

# --- 6. MIDAS Execution Engine (Gold VWAP - Paper / Testnet) ---
MIDAS_EXEC_ENABLED=false
MIDAS_EXEC_DRY_RUN=true
MIDAS_BINANCE_TESTNET=true
MIDAS_RISK_PER_TRADE_USD=3
MIDAS_MAKER_ENTRY=true
MIDAS_AUTO_LEVERAGE=true
MIDAS_LEVERAGE_MAX=25
MIDAS_LEVERAGE=25
MIDAS_EXEC_AFTER_LOSS_ONLY=true

# --- 7. Web Push (VAPID) & Multi-User Auth ---
VAPID_PRIVATE_KEY=your_vapid_private_key
EXEC_PRIV_KEY_PATH=keys/exec_rsa_priv.pem
EXEC_MULTI_USER=false
